<%- include('partials/header') %>

<!-- Top Hero Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> Live Factory Hub
      </span>
      <span class="text-xs text-slate-400"><%= today %></span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">Plant Dashboard</h1>
    <p class="text-xs sm:text-sm text-slate-400">Live production metrics, active raw material inventory & financial ledger totals</p>
  </div>

  <div class="flex items-center flex-wrap gap-2.5">
    <a href="/materials" class="px-4 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white rounded-xl text-xs sm:text-sm font-semibold transition shadow-lg shadow-blue-600/25 flex items-center gap-2">
      <i class="fa-solid fa-plus"></i> Inward / Dispatch
    </a>
    <a href="/jobs" class="px-4 py-2.5 bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center gap-2">
      <i class="fa-solid fa-hammer text-amber-400"></i> Record Production
    </a>
  </div>
</div>

<!-- Dynamic KPI Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
  <!-- Today's Production -->
  <div class="glass-card rounded-2xl p-5 relative overflow-hidden group">
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Today's Production</span>
      <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center group-hover:scale-110 transition">
        <i class="fa-solid fa-cubes text-lg"></i>
      </div>
    </div>
    <div class="mt-4">
      <div class="text-3xl font-extrabold text-white font-mono tracking-tight"><%= metrics.todayProductionUnits.toLocaleString() %> <span class="text-xs font-normal text-slate-400">Pcs</span></div>
      <div class="flex items-center justify-between text-xs text-slate-400 mt-2 pt-2 border-t border-slate-800/80">
        <span>Labor Cost:</span>
        <span class="font-mono font-bold text-amber-400">₹<%= metrics.todayLaborWages.toLocaleString() %></span>
      </div>
    </div>
  </div>

  <!-- Today's Dispatches -->
  <div class="glass-card rounded-2xl p-5 relative overflow-hidden group">
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Today's Dispatches</span>
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center group-hover:scale-110 transition">
        <i class="fa-solid fa-truck-arrow-right text-lg"></i>
      </div>
    </div>
    <div class="mt-4">
      <div class="text-3xl font-extrabold text-emerald-400 font-mono tracking-tight"><%= metrics.todayOutwardUnits.toLocaleString() %> <span class="text-xs font-normal text-slate-400">Units</span></div>
      <div class="flex items-center justify-between text-xs text-slate-400 mt-2 pt-2 border-t border-slate-800/80">
        <span>Dispatch Value:</span>
        <span class="font-mono font-bold text-emerald-400">₹<%= metrics.todayOutwardRevenue.toLocaleString() %></span>
      </div>
    </div>
  </div>

  <!-- Inward Raw Materials -->
  <div class="glass-card rounded-2xl p-5 relative overflow-hidden group">
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Today's Raw Inward</span>
      <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center group-hover:scale-110 transition">
        <i class="fa-solid fa-dolly text-lg"></i>
      </div>
    </div>
    <div class="mt-4">
      <div class="text-3xl font-extrabold text-white font-mono tracking-tight"><%= metrics.todayInwardTons.toLocaleString() %> <span class="text-xs font-normal text-slate-400">Tons</span></div>
      <div class="flex items-center justify-between text-xs text-slate-400 mt-2 pt-2 border-t border-slate-800/80">
        <span>Purchase Inward:</span>
        <span class="font-mono font-bold text-indigo-400">₹<%= metrics.todayInwardCost.toLocaleString() %></span>
      </div>
    </div>
  </div>

  <!-- Operational Expenses -->
  <div class="glass-card rounded-2xl p-5 relative overflow-hidden group">
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Today's Expenses</span>
      <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center group-hover:scale-110 transition">
        <i class="fa-solid fa-wallet text-lg"></i>
      </div>
    </div>
    <div class="mt-4">
      <div class="text-3xl font-extrabold text-rose-400 font-mono tracking-tight">₹<%= metrics.todayExpenses.toLocaleString() %></div>
      <div class="flex items-center justify-between text-xs text-slate-400 mt-2 pt-2 border-t border-slate-800/80">
        <span>Fuel & Operations</span>
        <span class="text-[10px] text-rose-400 font-semibold uppercase">Daily</span>
      </div>
    </div>
  </div>
</div>

<!-- Raw Material Inventory & Finished Goods Yard (Only Showing Recorded Items) -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Raw Material Stock (Only Mentioned / Recorded Materials) -->
  <div class="glass-card rounded-2xl p-5 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-base font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-cubes-stacked text-indigo-400"></i> Active Raw Material Stock
      </h3>
      <a href="/materials" class="text-xs text-blue-400 hover:underline">Add Inward →</a>
    </div>
    
    <% const rawKeys = Object.keys(rawMaterialStocks); %>
    <% if (rawKeys.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% rawKeys.forEach(function(mat) { %>
          <div class="p-3.5 bg-slate-800/60 rounded-xl border border-slate-700/50 flex items-center justify-between">
            <div>
              <span class="text-xs font-semibold text-slate-300"><%= mat %></span>
              <div class="text-xs text-slate-500">Unit: <%= rawMaterialStocks[mat].unit %></div>
            </div>
            <div class="text-lg font-bold font-mono text-white">
              <%= rawMaterialStocks[mat].quantity.toLocaleString() %> <span class="text-xs text-slate-400 font-normal"><%= rawMaterialStocks[mat].unit %></span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="p-6 bg-slate-800/30 rounded-xl border border-dashed border-slate-700/60 text-center">
        <i class="fa-solid fa-dolly text-2xl text-slate-600 mb-2"></i>
        <p class="text-xs text-slate-400 font-medium">No raw materials recorded yet.</p>
        <p class="text-[11px] text-slate-500 mt-0.5">Only items recorded via Material Inward will be displayed here.</p>
      </div>
    <% } %>
  </div>

  <!-- Finished Goods Yard Stock -->
  <div class="glass-card rounded-2xl p-5 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-base font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-warehouse text-amber-400"></i> Finished Goods Stock (Yard)
      </h3>
      <span class="text-xs text-slate-400">Available Pcs</span>
    </div>
    <% const prodKeys = Object.keys(productStocks); %>
    <% if (prodKeys.length > 0) { %>
      <div class="grid grid-cols-2 gap-2.5">
        <% prodKeys.forEach(function(prod) { %>
          <div class="p-3 bg-slate-800/60 rounded-xl border border-slate-700/50 flex flex-col justify-between">
            <span class="text-xs font-semibold text-slate-300 truncate" title="<%= prod %>"><%= prod %></span>
            <div class="text-lg font-bold <%= productStocks[prod].stock >= 0 ? 'text-emerald-400' : 'text-rose-400' %> font-mono mt-1">
              <%= productStocks[prod].stock.toLocaleString() %> <span class="text-[10px] text-slate-400 font-normal">Pcs</span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="p-6 bg-slate-800/30 rounded-xl border border-dashed border-slate-700/60 text-center">
        <p class="text-xs text-slate-400">No finished goods configured or recorded yet.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Financial Outstanding Overview -->
<div class="glass-card rounded-2xl p-5 space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="text-base font-bold text-white flex items-center gap-2">
      <i class="fa-solid fa-scale-balanced text-indigo-400"></i> Party Balances & Outstanding Ledgers
    </h3>
    <a href="/parties" class="text-xs text-blue-400 hover:underline">Full Party Directory →</a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-between">
      <div>
        <div class="text-xs text-slate-400 font-medium">Customer Receivables</div>
        <div class="text-2xl font-extrabold text-emerald-400 font-mono mt-1">₹<%= metrics.totalReceivables.toLocaleString() %></div>
      </div>
      <i class="fa-solid fa-hand-holding-dollar text-3xl text-emerald-500/30"></i>
    </div>
    <div class="p-4 bg-rose-500/10 border border-rose-500/20 rounded-xl flex items-center justify-between">
      <div>
        <div class="text-xs text-slate-400 font-medium">Supplier Payables</div>
        <div class="text-2xl font-extrabold text-rose-400 font-mono mt-1">₹<%= metrics.totalPayables.toLocaleString() %></div>
      </div>
      <i class="fa-solid fa-money-bill-transfer text-3xl text-rose-500/30"></i>
    </div>
  </div>
</div>

<!-- Recent Dispatches Table with 1-Click WhatsApp Slip -->
<div class="glass-card rounded-2xl p-5 space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="text-base font-bold text-white flex items-center gap-2">
      <i class="fa-solid fa-truck-fast text-emerald-400"></i> Live Dispatch Feed
    </h3>
    <a href="/materials" class="text-xs text-blue-400 hover:underline">View all dispatches →</a>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="text-xs uppercase bg-slate-800/80 text-slate-400 border-b border-slate-800">
        <tr>
          <th class="px-4 py-3 rounded-l-xl">Date</th>
          <th class="px-4 py-3">Customer Party</th>
          <th class="px-4 py-3">Product</th>
          <th class="px-4 py-3">Vehicle</th>
          <th class="px-4 py-3 text-right">Quantity</th>
          <th class="px-4 py-3 text-right">Amount (₹)</th>
          <th class="px-4 py-3 rounded-r-xl text-center">Challan</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% recentOutwards.forEach(function(outward) { %>
          <tr class="hover:bg-slate-800/30 transition">
            <td class="px-4 py-3 text-xs text-slate-400"><%= outward.date %></td>
            <td class="px-4 py-3 font-semibold text-white"><%= outward.party_name || 'Walk-in Customer' %></td>
            <td class="px-4 py-3 text-xs"><%= outward.material_type %></td>
            <td class="px-4 py-3 text-xs font-mono text-slate-400"><%= outward.vehicle_no || '-' %></td>
            <td class="px-4 py-3 text-right font-mono text-xs font-bold text-white"><%= outward.quantity_mt.toLocaleString() %> <%= outward.quantity_unit %></td>
            <td class="px-4 py-3 text-right font-mono font-bold text-emerald-400">₹<%= outward.amount.toLocaleString() %></td>
            <td class="px-4 py-3 text-center">
              <button onclick="shareDispatchWhatsApp('<%= outward.party_name || 'Walk-in' %>', '<%= outward.material_type %>', <%= outward.quantity_mt %>, '<%= outward.quantity_unit %>', '<%= outward.vehicle_no || '' %>', <%= outward.rate %>, <%= outward.amount %>, 0)"
                class="px-2.5 py-1 bg-emerald-500/10 hover:bg-emerald-500 hover:text-white text-emerald-400 border border-emerald-500/20 rounded-lg text-xs font-semibold transition flex items-center gap-1 mx-auto">
                <i class="fa-brands fa-whatsapp"></i> Slip
              </button>
            </td>
          </tr>
        <% }); %>
        <% if (recentOutwards.length === 0) { %>
          <tr><td colspan="7" class="px-4 py-8 text-center text-slate-500">No dispatches recorded today</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
