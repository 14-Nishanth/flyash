<%- include('partials/header') %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2">
      <a href="/parties" class="text-xs text-slate-400 hover:text-white"><i class="fa-solid fa-arrow-left mr-1"></i> Back to Parties</a>
    </div>
    <h1 class="text-2xl font-bold text-white tracking-tight mt-1"><%= party.name %> - Account Ledger</h1>
    <p class="text-sm text-slate-400">GST: <%= party.gstin || 'Unregistered' %> | Phone: <%= party.phone || 'N/A' %></p>
  </div>
  <div class="flex items-center gap-3">
    <div class="text-right">
      <div class="text-xs text-slate-400">Current Outstanding</div>
      <div class="text-2xl font-bold font-mono <%= final_balance > 0 ? 'text-emerald-400' : (final_balance < 0 ? 'text-rose-400' : 'text-slate-300') %>">
        ₹<%= Math.abs(final_balance).toLocaleString() %>
        <span class="text-xs font-normal text-slate-400"><%= final_balance > 0 ? '(Receivable)' : (final_balance < 0 ? '(Payable)' : '(Settled)') %></span>
      </div>
    </div>
    <button onclick="window.print()" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-sm font-medium transition border border-slate-700 flex items-center gap-1.5">
      <i class="fa-solid fa-print"></i> Print Statement
    </button>
  </div>
</div>

<!-- Statement Table -->
<div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="text-xs uppercase bg-slate-800/80 text-slate-400 border-b border-slate-800">
        <tr>
          <th class="px-5 py-3.5">Date</th>
          <th class="px-5 py-3.5">Transaction Type</th>
          <th class="px-5 py-3.5">Details</th>
          <th class="px-5 py-3.5">Ref / Vehicle</th>
          <th class="px-5 py-3.5 text-right text-emerald-400">Debit (+)</th>
          <th class="px-5 py-3.5 text-right text-rose-400">Credit (-)</th>
          <th class="px-5 py-3.5 text-right font-bold text-white">Running Balance</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
        <tr class="bg-slate-800/30">
          <td class="px-5 py-3 text-slate-400">Base</td>
          <td class="px-5 py-3 font-sans font-medium text-slate-300">Opening Balance</td>
          <td class="px-5 py-3 text-slate-500 font-sans">Initial carry forward</td>
          <td class="px-5 py-3 text-slate-500">-</td>
          <td class="px-5 py-3 text-right text-slate-500">-</td>
          <td class="px-5 py-3 text-right text-slate-500">-</td>
          <td class="px-5 py-3 text-right font-bold text-slate-200">₹<%= party.opening_balance.toLocaleString() %></td>
        </tr>
        <% ledger.forEach(function(row) { %>
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-5 py-3 text-slate-400"><%= row.date %></td>
            <td class="px-5 py-3 font-sans font-medium text-white"><%= row.entry_type %></td>
            <td class="px-5 py-3 text-slate-300 font-sans"><%= row.details %></td>
            <td class="px-5 py-3 text-slate-400"><%= row.ref || '-' %></td>
            <td class="px-5 py-3 text-right text-emerald-400">
              <%= row.debit > 0 ? '₹' + row.debit.toLocaleString() : '-' %>
            </td>
            <td class="px-5 py-3 text-right text-rose-400">
              <%= row.credit > 0 ? '₹' + row.credit.toLocaleString() : '-' %>
            </td>
            <td class="px-5 py-3 text-right font-bold <%= row.running_balance >= 0 ? 'text-white' : 'text-rose-400' %>">
              ₹<%= row.running_balance.toLocaleString() %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
