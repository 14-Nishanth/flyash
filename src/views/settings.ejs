<%- include('partials/header') %>

<div class="max-w-4xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-white tracking-tight">System & Alert Settings</h1>
    <p class="text-sm text-slate-400">Configure Telegram bots, email reports, and plant alerts</p>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
    <form id="settingsForm" class="space-y-6">
      <!-- General Alert Settings -->
      <div>
        <h3 class="text-base font-semibold text-white mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
          <i class="fa-solid fa-user-shield text-blue-400"></i> Plant Ownership Details
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Owner / Manager Name</label>
            <input type="text" name="owner_name" value="<%= settings ? settings.owner_name : '' %>" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Owner Email Address</label>
            <input type="email" name="owner_email" value="<%= settings ? settings.owner_email : '' %>" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
          </div>
        </div>
      </div>

      <!-- Telegram Bot Automation -->
      <div>
        <h3 class="text-base font-semibold text-white mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
          <i class="fa-brands fa-telegram text-sky-400"></i> Telegram Bot Integration
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Telegram Bot Token</label>
            <input type="text" name="telegram_bot_token" value="<%= settings ? settings.telegram_bot_token || '' : '' %>" placeholder="123456789:ABCdefGHI..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Telegram Chat ID / Channel ID</label>
            <input type="text" name="telegram_chat_id" value="<%= settings ? settings.telegram_chat_id || '' : '' %>" placeholder="-100123456789" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
          </div>
        </div>
      </div>

      <!-- Daily Digest Automation -->
      <div>
        <h3 class="text-base font-semibold text-white mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
          <i class="fa-solid fa-clock text-amber-400"></i> Automated Daily Plant Digest
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Digest Channel</label>
            <select name="daily_digest_channel" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
              <option value="both" <%= settings && settings.daily_digest_channel === 'both' ? 'selected' : '' %>>Telegram & Email</option>
              <option value="telegram" <%= settings && settings.daily_digest_channel === 'telegram' ? 'selected' : '' %>>Telegram Only</option>
              <option value="email" <%= settings && settings.daily_digest_channel === 'email' ? 'selected' : '' %>>Email Only</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Digest Shift End Time</label>
            <input type="text" name="daily_digest_time" value="<%= settings ? settings.daily_digest_time : '19:00' %>" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
          </div>
          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="daily_digest_enabled" value="true" <%= settings && settings.daily_digest_enabled ? 'checked' : '' %> class="rounded bg-slate-700 border-slate-600 text-blue-600">
              <span class="text-xs text-slate-200">Enable Daily Digest</span>
            </label>
          </div>
        </div>
      </div>

      <div class="flex justify-end pt-4 border-t border-slate-800">
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-sm font-medium transition shadow-lg shadow-blue-600/20">
          Save Settings
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('settingsForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    data.daily_digest_enabled = formData.get('daily_digest_enabled') === 'true';
    const res = await fetch('/api/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) alert('Settings updated successfully!');
  });
</script>

<%- include('partials/footer') %>
