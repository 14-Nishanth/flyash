<%- include('partials/header') %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-white tracking-tight">Party & Account Directory</h1>
    <p class="text-sm text-slate-400">Manage customers, suppliers, ledgers, and outstanding dues</p>
  </div>
  <button onclick="document.getElementById('addPartyModal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-sm font-medium transition shadow-lg shadow-blue-600/20 flex items-center gap-2">
    <i class="fa-solid fa-user-plus"></i> Add New Party
  </button>
</div>

<!-- Parties Table -->
<div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="text-xs uppercase bg-slate-800/80 text-slate-400 border-b border-slate-800">
        <tr>
          <th class="px-5 py-3.5">Party Name</th>
          <th class="px-5 py-3.5">Type</th>
          <th class="px-5 py-3.5">Phone / GSTIN</th>
          <th class="px-5 py-3.5 text-right">Outstanding Balance</th>
          <th class="px-5 py-3.5 text-center">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% parties.forEach(function(party) { %>
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-5 py-4">
              <a href="/parties/<%= party.id %>/ledger" class="font-bold text-white hover:text-blue-400 transition flex items-center gap-2">
                <%= party.name %>
                <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-500"></i>
              </a>
              <% if (party.address) { %>
                <div class="text-xs text-slate-500 mt-0.5"><%= party.address %></div>
              <% } %>
            </td>
            <td class="px-5 py-4">
              <span class="px-2.5 py-1 text-xs font-semibold rounded-lg uppercase tracking-wider
                <%= party.party_type === 'customer' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : '' %>
                <%= party.party_type === 'supplier' ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20' : '' %>
                <%= party.party_type === 'both' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : '' %>">
                <%= party.party_type %>
              </span>
            </td>
            <td class="px-5 py-4 text-xs font-mono text-slate-400">
              <div><%= party.phone || '-' %></div>
              <% if (party.gstin) { %><div class="text-slate-500 text-[11px]">GST: <%= party.gstin %></div><% } %>
            </td>
            <td class="px-5 py-4 text-right">
              <span class="text-base font-bold font-mono <%= party.outstanding > 0 ? 'text-emerald-400' : (party.outstanding < 0 ? 'text-rose-400' : 'text-slate-400') %>">
                ₹<%= Math.abs(party.outstanding).toLocaleString() %>
              </span>
              <div class="text-[11px] text-slate-500">
                <%= party.outstanding > 0 ? '(Receivable)' : (party.outstanding < 0 ? '(Payable)' : 'Settled') %>
              </div>
            </td>
            <td class="px-5 py-4 text-center">
              <div class="flex items-center justify-center gap-2">
                <a href="/parties/<%= party.id %>/ledger" class="p-2 bg-slate-800 hover:bg-slate-700 text-blue-400 rounded-lg text-xs transition" title="Statement / Ledger">
                  <i class="fa-solid fa-book-open"></i>
                </a>
                <button onclick="openPaymentModal(<%= party.id %>, '<%= party.name %>')" class="p-2 bg-slate-800 hover:bg-slate-700 text-emerald-400 rounded-lg text-xs transition" title="Record Payment">
                  <i class="fa-solid fa-indian-rupee-sign"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }); %>
        <% if (parties.length === 0) { %>
          <tr><td colspan="5" class="px-5 py-8 text-center text-slate-500">No parties added yet</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal: Add Party -->
<div id="addPartyModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <h3 class="text-lg font-bold text-white">Add New Party</h3>
      <button onclick="document.getElementById('addPartyModal').classList.add('hidden')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>
    <form id="partyForm" class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Party Name *</label>
        <input type="text" name="name" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-blue-500 text-sm">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Party Type</label>
          <select name="party_type" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-blue-500 text-sm">
            <option value="customer">Customer</option>
            <option value="supplier">Supplier</option>
            <option value="both">Both</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Phone Number</label>
          <input type="text" name="phone" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-blue-500 text-sm">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">GSTIN</label>
          <input type="text" name="gstin" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-blue-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Opening Balance (₹)</label>
          <input type="number" step="any" name="opening_balance" value="0" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-blue-500 text-sm">
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Address</label>
        <textarea name="address" rows="2" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-blue-500 text-sm"></textarea>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('addPartyModal').classList.add('hidden')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-medium">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-sm font-medium">Save Party</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Record Payment -->
<div id="paymentModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <h3 class="text-lg font-bold text-white">Record Payment - <span id="modalPartyName" class="text-blue-400"></span></h3>
      <button onclick="document.getElementById('paymentModal').classList.add('hidden')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>
    <form id="paymentForm" class="space-y-4">
      <input type="hidden" id="paymentPartyId" name="party_id">
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Payment Date</label>
        <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Type</label>
          <select name="payment_type" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
            <option value="received">Received (From Customer)</option>
            <option value="paid">Paid (To Supplier)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Amount (₹) *</label>
          <input type="number" step="any" name="amount" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Payment Mode</label>
          <select name="mode" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
            <option value="cash">Cash</option>
            <option value="upi">UPI / GPay / PhonePe</option>
            <option value="bank">Bank Transfer / NEFT</option>
            <option value="cheque">Cheque</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Ref / Txn No.</label>
          <input type="text" name="reference_no" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Notes / Remarks</label>
        <input type="text" name="notes" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('paymentModal').classList.add('hidden')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-medium">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-sm font-medium">Record Payment</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('partyForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    const res = await fetch('/api/parties', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) window.location.reload();
  });

  function openPaymentModal(partyId, partyName) {
    document.getElementById('paymentPartyId').value = partyId;
    document.getElementById('modalPartyName').textContent = partyName;
    document.getElementById('paymentModal').classList.remove('hidden');
  }

  document.getElementById('paymentForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    const partyId = data.party_id;
    const res = await fetch(`/api/parties/${partyId}/payment`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) window.location.reload();
  });
</script>

<%- include('partials/footer') %>
