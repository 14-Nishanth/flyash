<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fly Ash Plant Manager - Dynamic Edition</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased pb-20 md:pb-0">
  <!-- Dynamic Top Bar -->
  <nav class="glass-card sticky top-0 z-50 border-b border-slate-800/80 bg-slate-900/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo & Branding -->
        <div class="flex items-center space-x-3">
          <a href="/" class="flex items-center space-x-2.5 group">
            <div class="w-10 h-10 bg-gradient-to-tr from-blue-600 to-indigo-500 rounded-xl flex items-center justify-center text-white font-bold shadow-lg shadow-blue-500/25 transition group-hover:scale-105">
              <i class="fa-solid fa-cubes-stacked text-lg"></i>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-lg font-bold tracking-tight text-white">Fly Ash Manager</span>
                <span class="text-[10px] px-1.5 py-0.5 bg-blue-500/10 text-blue-400 border border-blue-500/20 rounded font-mono font-semibold">TS 2.0</span>
              </div>
              <p class="text-[11px] text-slate-400 hidden sm:block">Industrial ERP & Plant Automation</p>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center space-x-1 pl-6">
            <a href="/" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-chart-pie text-blue-400"></i> Dashboard
            </a>
            <a href="/materials" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-truck-ramp-box text-emerald-400"></i> Materials & Stock
            </a>
            <a href="/parties" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-users text-indigo-400"></i> Parties & Ledger
            </a>
            <a href="/jobs" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-hammer text-amber-400"></i> Production & Labor
            </a>
            <a href="/employees" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-clipboard-user text-teal-400"></i> Attendance
            </a>
            <a href="/wages" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-money-bill-wave text-green-400"></i> Wages Sheet
            </a>
            <a href="/expenses" class="px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-800/80 transition flex items-center gap-1.5 text-slate-300 hover:text-white">
              <i class="fa-solid fa-wallet text-rose-400"></i> Expenses
            </a>
          </div>
        </div>

        <!-- Right Controls: Dynamic Theme Toggle & Actions -->
        <div class="flex items-center space-x-2">
          <!-- Dynamic Light / Dark Theme Button -->
          <button onclick="toggleTheme()" class="p-2.5 bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 rounded-xl transition border border-slate-700/50 flex items-center justify-center shadow-inner" title="Toggle Yard High-Contrast / Dark Mode">
            <i id="theme-toggle-icon" class="fa-solid fa-sun text-amber-400 text-sm"></i>
          </button>

          <!-- Settings -->
          <a href="/settings" class="p-2.5 bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 rounded-xl transition border border-slate-700/50" title="Plant Configuration & Telegram Alerts">
            <i class="fa-solid fa-sliders text-sm"></i>
          </a>

          <!-- Logout -->
          <button onclick="logout()" class="px-3 py-2 bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500 hover:text-white rounded-xl text-xs font-semibold transition duration-200 flex items-center gap-1.5">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span class="hidden sm:inline">Logout</span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile Bottom Floating Navigation Bar -->
  <div class="fixed bottom-0 inset-x-0 z-50 lg:hidden bg-slate-900/95 border-t border-slate-800 backdrop-blur-xl py-2 px-3 flex items-center justify-around shadow-2xl">
    <a href="/" class="flex flex-col items-center gap-1 text-slate-400 hover:text-blue-400 transition">
      <i class="fa-solid fa-chart-pie text-lg"></i>
      <span class="text-[10px] font-medium">Dashboard</span>
    </a>
    <a href="/materials" class="flex flex-col items-center gap-1 text-slate-400 hover:text-emerald-400 transition">
      <i class="fa-solid fa-truck-ramp-box text-lg"></i>
      <span class="text-[10px] font-medium">Materials</span>
    </a>
    <a href="/jobs" class="flex flex-col items-center gap-1 text-slate-400 hover:text-amber-400 transition">
      <i class="fa-solid fa-hammer text-lg"></i>
      <span class="text-[10px] font-medium">Production</span>
    </a>
    <a href="/parties" class="flex flex-col items-center gap-1 text-slate-400 hover:text-indigo-400 transition">
      <i class="fa-solid fa-users text-lg"></i>
      <span class="text-[10px] font-medium">Parties</span>
    </a>
    <a href="/wages" class="flex flex-col items-center gap-1 text-slate-400 hover:text-green-400 transition">
      <i class="fa-solid fa-money-bill-wave text-lg"></i>
      <span class="text-[10px] font-medium">Wages</span>
    </a>
  </div>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
