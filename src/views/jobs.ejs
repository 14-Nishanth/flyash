<%- include('partials/header') %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Production & Piece-Rate Labor</h1>
    <p class="text-xs sm:text-sm text-slate-400">Tray calculation, breakage wastage deduction, and gang wage distribution</p>
  </div>
  <div class="flex items-center gap-2">
    <button onclick="document.getElementById('jobModal').classList.remove('hidden')" class="px-4 py-2.5 bg-gradient-to-r from-amber-600 to-yellow-600 hover:from-amber-500 hover:to-yellow-500 text-white rounded-xl text-xs sm:text-sm font-semibold transition shadow-lg shadow-amber-600/25 flex items-center gap-2">
      <i class="fa-solid fa-plus"></i> New Production Log
    </button>
  </div>
</div>

<!-- Job Wage Entries Table with Live Search -->
<div class="glass-card rounded-2xl overflow-hidden shadow-xl">
  <div class="px-5 py-4 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-800/40">
    <h3 class="text-base font-bold text-white flex items-center gap-2">
      <i class="fa-solid fa-clipboard-list text-amber-400"></i> Production & Labor Logs
    </h3>
    <div class="relative max-w-xs w-full">
      <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500">
        <i class="fa-solid fa-magnifying-glass text-xs"></i>
      </span>
      <input type="text" id="jobSearch" placeholder="Filter by product, gang..."
        class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-8 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-500">
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="text-xs uppercase bg-slate-800/80 text-slate-400 border-b border-slate-800">
        <tr>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Product & Rate</th>
          <th class="px-4 py-3">Labor Gang / Workers</th>
          <th class="px-4 py-3">Trays / Gross</th>
          <th class="px-4 py-3">Breakage Cut</th>
          <th class="px-4 py-3 text-right">Net Payable Pcs</th>
          <th class="px-4 py-3 text-right">Total Labor Wage</th>
        </tr>
      </thead>
      <tbody id="jobTableBody" class="divide-y divide-slate-800/60">
        <% jobs.forEach(function(job) { %>
          <tr class="hover:bg-slate-800/30 transition">
            <td class="px-4 py-3.5 text-xs text-slate-400 font-mono"><%= job.date %></td>
            <td class="px-4 py-3.5">
              <div class="font-semibold text-white"><%= job.product_name %></div>
              <div class="text-[11px] text-slate-400"><%= job.job_type %> @ ₹<%= job.rate_per_unit %>/pc</div>
            </td>
            <td class="px-4 py-3.5 text-xs">
              <div class="font-semibold text-amber-400"><%= job.group_name || 'Individual Workers' %> (<%= job.worker_count %> workers)</div>
              <div class="text-slate-400">₹<%= job.wage_per_worker %>/worker</div>
            </td>
            <td class="px-4 py-3.5 font-mono text-xs">
              <%= job.tray_count > 0 ? job.tray_count + ' trays (' + job.gross_quantity + ' pcs)' : job.quantity + ' pcs' %>
            </td>
            <td class="px-4 py-3.5 font-mono text-xs text-rose-400">
              <%= job.total_wastage > 0 ? '-' + job.total_wastage + ' pcs (₹' + job.wastage_amount + ')' : '-' %>
            </td>
            <td class="px-4 py-3.5 text-right font-mono text-xs font-bold text-white">
              <%= job.quantity.toLocaleString() %> pcs
            </td>
            <td class="px-4 py-3.5 text-right font-mono font-bold text-amber-400 text-sm">
              ₹<%= job.total_amount.toLocaleString() %>
            </td>
          </tr>
        <% }); %>
        <% if (jobs.length === 0) { %>
          <tr><td colspan="7" class="px-4 py-8 text-center text-slate-500">No production or job records found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal: New Job Entry with Live Reactive Calculator -->
<div id="jobModal" class="hidden fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="glass-card rounded-2xl max-w-xl w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-calculator text-amber-400"></i> Record Daily Production & Wages
      </h3>
      <button onclick="document.getElementById('jobModal').classList.add('hidden')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>
    <form id="jobForm" class="space-y-4">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Production Date</label>
          <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Operation Type</label>
          <select name="job_type" id="jobTypeSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs">
            <option value="Production">Production</option>
            <option value="Loading Only">Loading Only</option>
            <option value="Unloading Only">Unloading Only</option>
            <option value="Both Loading & Unloading">Both Loading & Unloading</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Product</label>
          <select name="product_name" id="productSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs">
            <% rates.forEach(function(r) { %>
              <option value="<%= r.product_name %>" data-rate="<%= r.rate_per_piece %>" data-tray="<%= r.pieces_per_tray %>" data-waste="<%= r.wastage_per_tray %>">
                <%= r.product_name %> (<%= r.job_type %> - ₹<%= r.rate_per_piece %>/pc)
              </option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Piece Rate (₹ / pc)</label>
          <input type="number" step="any" name="rate_per_unit" id="rateInput" value="0.60" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs">
        </div>
      </div>

      <!-- Reactive Inputs -->
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Tray / Track Count</label>
          <input type="number" step="any" name="tray_count" id="trayCountInput" value="36" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs font-bold text-amber-400">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Pcs / Tray</label>
          <input type="number" step="any" name="pieces_per_tray" id="pcsTrayInput" value="105" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Breakage Cut / Tray</label>
          <input type="number" step="any" name="wastage_per_tray" id="wasteTrayInput" value="5" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs">
        </div>
      </div>

      <!-- Dynamic Live Calculation Preview -->
      <div id="liveCalculationPreview"></div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Labor Gang / Team</label>
        <select name="group_id" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-xs mb-2">
          <option value="">-- Select Gang --</option>
          <% groups.forEach(function(g) { %>
            <option value="<%= g.id %>"><%= g.name %></option>
          <% }); %>
        </select>
        <div class="text-[11px] text-slate-400 mb-1">Or select individual team workers:</div>
        <div class="max-h-28 overflow-y-auto bg-slate-950/60 p-2.5 rounded-xl border border-slate-800 grid grid-cols-2 gap-2 text-xs">
          <% employees.forEach(function(emp) { %>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="workerIds" value="<%= emp.id %>" class="rounded bg-slate-800 border-slate-700 text-amber-500">
              <span class="text-slate-300"><%= emp.name %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-slate-800">
        <button type="button" onclick="document.getElementById('jobModal').classList.add('hidden')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold">Cancel</button>
        <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-semibold shadow-lg shadow-amber-600/20">Save Record</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    setupTableSearch('jobSearch', '#jobTableBody');

    const productSelect = document.getElementById('productSelect');
    if (productSelect) {
      productSelect.addEventListener('change', (e) => {
        const opt = e.target.selectedOptions[0];
        if (opt) {
          document.getElementById('rateInput').value = opt.getAttribute('data-rate') || 0.60;
          document.getElementById('pcsTrayInput').value = opt.getAttribute('data-tray') || 105;
          document.getElementById('wasteTrayInput').value = opt.getAttribute('data-waste') || 5;
          document.getElementById('trayCountInput').dispatchEvent(new Event('input'));
        }
      });
    }

    document.getElementById('jobForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const workerIds = formData.getAll('workerIds').map(Number);
      const data = Object.fromEntries(formData.entries());
      data.workerIds = workerIds;
      const res = await fetch('/api/jobs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        showToast('Production record saved successfully!', 'success');
        setTimeout(() => window.location.reload(), 600);
      }
    });
  });
</script>

<%- include('partials/footer') %>
